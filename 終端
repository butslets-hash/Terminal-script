---------------------------------------------------------------------
local function startTerminal()
	local SCRIPTS = {
		{ win = "VELOCIDADE", title = "Velocidade", names = { "velocidade", "speed" }, open = openVelocidade },
		{ win = "AUTOCLICK", title = "Auto click", names = { "auto click", "autoclick" }, open = openAutoClick },
		{ win = "TELEPORTE", title = "Teletransporte", names = { "teletransporte", "teleporte", "teleport" }, open = openTeleport },
		{ win = "AUDIO", title = "Áudio", names = { "áudio", "Áudio", "audio" }, open = openAudio },
	}

	local function findScript(cmd)
		local low = cmd:lower()
		for _, s in ipairs(SCRIPTS) do
			for _, n in ipairs(s.names) do
				if n == cmd or n == low then
					return s
				end
			end
		end
		return nil
	end

	local f, body = createWindow("TERMINAL", "TERMINAL.EXE", center(0, -60))

	local lines = {}
	local logBox = make("Frame", {
		Size = UDim2.new(1, 0, 0, 172),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, body)
	local log = make("TextLabel", {
		Size = UDim2.new(1, -4, 1, 0),
		Position = UDim2.fromOffset(2, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = GREEN,
		Font = FONT,
		TextSize = 11,
		TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextWrapped = true,
	}, logBox)

	local function out(t)
		table.insert(lines, t)
		if #lines > 60 then
			table.remove(lines, 1)
		end
		log.Text = table.concat(lines, "\n")
	end

	label(body, "C:\\>", 0, 192, 30, 20)
	local box = make("TextBox", {
		Size = UDim2.new(1, -34, 0, 20),
		Position = UDim2.fromOffset(32, 192),
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = GREEN,
		PlaceholderText = L("ph"),
		PlaceholderColor3 = DIM,
		Font = FONT,
		TextSize = 11,
		ClearTextOnFocus = false,
		TextXAlignment = LEFT,
	}, body)
	border(box)

	local busy = false
	local function setBusy(b)
		busy = b
		box.TextEditable = not b
	end

	local function loadScript(s)
		setBusy(true)
		out(L("loading") .. s.title .. "...")
		out("")
		local idx = #lines
		local BAR = 16

		task.spawn(function()
			local pct = 0
			while pct < 100 do
				pct = math.min(100, pct + 5)
				local filled = math.floor(pct / 100 * BAR)
				lines[idx] = string.format("[%s%s] %3d%%", string.rep("#", filled), string.rep(".", BAR - filled), pct)
				log.Text = table.concat(lines, "\n")
				task.wait(0.04)
			end
			out(L("ok"))
			local ok, err = pcall(s.open)
			if not ok then
				out(L("err") .. tostring(err))
			end
			setBusy(false)
		end)
	end

	local prevLen = 0
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local len = #box.Text
		if len > prevLen then
			sfx(KEY_SFX)
		end
		prevLen = len
	end)

	box.FocusLost:Connect(function(enter)
		if not enter or busy then
			return
		end

		local cmd = (box.Text:match("^%s*(.-)%s*$")) or ""
		box.Text = ""
		prevLen = 0
		sfx(ENTER_SFX)

		local low = cmd:lower()
		if cmd == "" then
			-- nada
		elseif low == "help" or low == "ajuda" then
			out(L("help"))
			out(L("helpExtra"))
		elseif low == "clear" or low == "limpar" then
			lines = {}
			log.Text = ""
		else
			local s = findScript(cmd)
			if not s then
				out(L("notFound") .. cmd)
			elseif screen:FindFirstChild(s.win) then
				out(s.title .. L("alreadyOpen"))
			else
				loadScript(s)
			end
		end

		task.defer(function()
			if not busy then
				box:CaptureFocus()
			end
		end)
	end)
end

